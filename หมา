local esp = {}
local function clearEsp(p)
    local o = esp[p]
    if o then
        pcall(function() o.hl:Destroy() end)
        pcall(function() o.bb:Destroy() end)
        esp[p] = nil
    end
end

local function tl(parent, size, pos, ts)
    local l = Instance.new("TextLabel")
    l.BackgroundTransparency = 1
    l.Size = size
    l.Position = pos
    l.Font = Enum.Font.SourceSansBold
    l.TextSize = ts or 14
    l.TextColor3 = Color3.new(1, 1, 1)
    l.TextStrokeTransparency = 0
    l.TextWrapped = true
    l.Text = ""
    l.Parent = parent
    return l
end

local function buildEsp(p, char)
    clearEsp(p)
    local head = char:FindFirstChild("Head")
    if not head then return end
    local hl = Instance.new("Highlight")
    hl.FillColor = C.accent
    hl.OutlineColor = Color3.new(1, 1, 1)
    hl.FillTransparency = 0.6
    hl.Enabled = false
    hl.Parent = char

    local bb = Instance.new("BillboardGui")
    bb.Size = UDim2.fromOffset(160, 64)
    bb.StudsOffset = Vector3.new(0, 3, 0)
    bb.AlwaysOnTop = true
    bb.Adornee = head
    bb.Enabled = false
    bb.Parent = head

    local o = { char = char, hl = hl, bb = bb }
    o.name = tl(bb, UDim2.new(1, 0, 0, 16), UDim2.new(0, 0, 0, 0), 15)
    o.hpBack = Instance.new("Frame")
    o.hpBack.Size = UDim2.fromOffset(120, 6)
    o.hpBack.Position = UDim2.new(0.5, -60, 0, 19)
    o.hpBack.BackgroundColor3 = Color3.fromRGB(20, 20, 20)
    o.hpBack.BorderSizePixel = 0
    o.hpBack.Parent = bb
    o.hpFill = Instance.new("Frame")
    o.hpFill.Size = UDim2.new(1, 0, 1, 0)
    o.hpFill.BackgroundColor3 = Color3.fromRGB(60, 220, 90)
    o.hpFill.BorderSizePixel = 0
    o.hpFill.Parent = o.hpBack
    o.dist = tl(bb, UDim2.new(1, 0, 0, 14), UDim2.new(0, 0, 0, 27), 13)
    o.bag = tl(bb, UDim2.new(1, 0, 0, 22), UDim2.new(0, 0, 0, 41), 12)
    esp[p] = o
end

local function bagText(p, char)
    local t = {}
    local tool = char:FindFirstChildOfClass("Tool")
    if tool then table.insert(t, "[" .. tool.Name .. "]") end
    local bp = p:FindFirstChild("Backpack")
    if bp then
        for _, v in ipairs(bp:GetChildren()) do
            if v:IsA("Tool") then table.insert(t, v.Name) end
        end
    end
    return table.concat(t, ", ")
end

local acc = 0
bind(RunService.Heartbeat, function(dt)
    -- วิ่งเร็ว
    if S.speed then
        local h = getHum()
        if h then h.WalkSpeed = S.speedVal end
    end
    acc = acc + dt
    if acc < 0.1 then return end
    acc = 0
    local me = getHRP()
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= player then
            local char = p.Character
            if not char then
                clearEsp(p)
            else
                local o = esp[p]
                if not o or o.char ~= char or not o.hl.Parent then
                    buildEsp(p, char)
                    o = esp[p]
                end
                if o then
                    local hum = char:FindFirstChildOfClass("Humanoid")
                    local hrp = char:FindFirstChild("HumanoidRootPart")
                    local d = (me and hrp) and (me.Position - hrp.Position).Magnitude or 0
                    local show = S.esp and hum and hum.Health > 0 and d <= S.maxDist
                    o.hl.Enabled = (show and S.box) and true or false
                    o.bb.Enabled = (show and (S.names or S.hp or S.dist or S.bag)) and true or false
                    if show then
                        o.name.Visible = S.names
                        o.name.Text = p.Name
                        o.hpBack.Visible = S.hp
                        local r = math.clamp(hum.Health / math.max(hum.MaxHealth, 1), 0, 1)
                        o.hpFill.Size = UDim2.new(r, 0, 1, 0)
                        o.hpFill.BackgroundColor3 = Color3.fromRGB(255, 60, 60):Lerp(Color3.fromRGB(60, 220, 90), r)
                        o.dist.Visible = S.dist
                        o.dist.Text = math.floor(d) .. " m"
                        o.bag.Visible = S.bag
                        o.bag.Text = S.bag and bagText(p, char) or ""
                    end
                end
            end
        end
    end
end)
