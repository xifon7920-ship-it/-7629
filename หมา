local selLbl = mkLabel(selRow, "เป้าหมาย: ยังไม่เลือก", UDim2.new(1, -20, 1, 0), UDim2.new(0, 12, 0, 0), nil, C.accent, Enum.Font.SourceSansBold)

local function refreshList()
    for _, c in ipairs(pT:GetChildren()) do
        if c.Name:sub(1, 2) == "P_" then c:Destroy() end
    end
    local order = 100
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= player then
            local r = row(pT, 40)
            r.Name = "P_" .. p.Name
            r.LayoutOrder = order
            order = order + 1
            local b = Instance.new("TextButton")
            b.Size = UDim2.new(1, 0, 1, 0)
            b.BackgroundTransparency = 1
            b.Text = p.DisplayName .. "  (@" .. p.Name .. ")"
            b.Font = Enum.Font.SourceSans
            b.TextSize = 17
            b.TextColor3 = C.text
            b.Parent = r
            b.MouseButton1Click:Connect(function()
                selected = p
                selLbl.Text = "เป้าหมาย: " .. p.Name
            end)
        end
    end
end
do
    local r = row(pT, 40)
    local b = Instance.new("TextButton")
    b.Size = UDim2.new(1, 0, 1, 0)
    b.BackgroundTransparency = 1
    b.Text = "รีเฟรชรายชื่อผู้เล่น"
    b.Font = Enum.Font.SourceSansBold
    b.TextSize = 17
    b.TextColor3 = C.text
    b.Parent = r
    b.MouseButton1Click:Connect(refreshList)
end
bind(Players.PlayerAdded, refreshList)
bind(Players.PlayerRemoving, function() task.defer(refreshList) end)
refreshList()

